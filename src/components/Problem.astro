---
const loopSteps = [
  {
    n: "01",
    title: "Assume",
    tag: "Not standardised",
    desc: "Designs are picked by experience, or by quick estimates nobody fully trusts.",
  },
  {
    n: "02",
    title: "Simulate",
    desc: "Days of setup before the first reliable run.",
  },
  {
    n: "03",
    title: "Review",
    desc: "Wrong? Start again.",
  },
];

const evidence = [
  {
    figure: "Up to 6 months",
    label: "to resolve one design problem",
    source: "Aerospace propulsion engineer, interviewed Sept 2026",
  },
  {
    figure: "A day to a month",
    label: "to prepare a single simulation",
    source: "Simulation engineer, interviewed Sept 2026",
  },
  {
    figure: "~100 simulations",
    label: "and a week of compute for one optimisation",
    source: "CFD optimisation engineer, interviewed Oct 2026",
  },
];
---

<section class="section problem" id="problem">
  <div class="shell">
    <div class="problem-head reveal">
      <p class="eyebrow eyebrow--muted">The problem</p>
      <h2>Every design loop starts with a guess.</h2>
    </div>

    <div class="loop reveal">
      {
        loopSteps.map((s, i) => (
          <div class="loop-step">
            <div class="rail">
              <span class="dot" />
              {i < loopSteps.length - 1 && <span class="line" />}
            </div>
            <p class="n">
              {s.n}
              {s.tag && <span class="tag"> · {s.tag}</span>}
            </p>
            <h3 class="t">{s.title}</h3>
            <p class="d">{s.desc}</p>
          </div>
        ))
      }
    </div>

    <p class="loop-label reveal">↻ Dozens to hundreds of runs for one workable design.</p>
    <p class="closing reveal">Every wasted run costs margin and capacity.</p>

    <div class="evidence-row reveal">
      {
        evidence.map((e) => (
          <div class="evidence">
            <p class="figure">{e.figure}</p>
            <p class="figure-label">{e.label}</p>
            <p class="figure-source mono">{e.source}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .problem-head {
    max-width: 56ch;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* ── Loop ── */
  .loop {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-bottom: 1.6rem;
  }
  .loop-step {
    padding: 0 1.1rem;
    border-left: 1px solid var(--hair);
  }
  .loop-step:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .rail {
    position: relative;
    height: 14px;
    margin-bottom: 1rem;
  }
  .dot {
    position: absolute;
    left: 0;
    top: 3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .line {
    position: absolute;
    left: 8px;
    right: -1.1rem;
    top: 6.5px;
    border-top: 1px dashed var(--hair-strong);
  }
  .n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .tag {
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .t {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0;
    margin: 0 0 0.5rem;
  }
  .d {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }

  .loop-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    border-top: 1px solid var(--hair);
    padding-top: 1rem;
  }
  .closing {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--ink);
    margin-top: 0.6rem;
    margin-bottom: clamp(2.2rem, 4vw, 3rem);
  }

  /* ── Evidence ── */
  .evidence-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .evidence {
    background: var(--paper-2);
    padding: 1.75rem;
  }
  .figure {
    font-family: var(--font-mono);
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin: 0 0 0.6rem;
  }
  .figure-label {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  .figure-source {
    font-size: 0.72rem;
    color: var(--muted);
    opacity: 0.85;
    margin: 0;
  }

  @media (max-width: 760px) {
    .loop {
      grid-template-columns: 1fr;
    }
    .loop-step {
      border-left: 1px solid var(--hair);
      padding: 0 0 1.6rem 1.4rem;
    }
    .loop-step:first-child {
      padding-left: 1.4rem;
      border-left: 1px solid var(--hair);
    }
    .loop-step:last-child {
      padding-bottom: 0;
    }
    .rail {
      height: 0;
      margin-bottom: 0;
    }
    .dot {
      left: -1.4rem;
      top: 4px;
    }
    .line {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .evidence-row {
      grid-template-columns: 1fr;
    }
  }
</style>
