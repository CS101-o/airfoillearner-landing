  }
  .mission-inner {
    text-align: center;
  }
  .mission-inner .eyebrow {
    display: flex;
    justify-content: center;
  }
  .mission-line {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.3;
    color: var(--ink);
    max-width: 30ch;
    margin-inline: auto;
  }
