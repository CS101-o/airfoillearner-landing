<section class="section mission" id="mission">
  <div class="shell mission-inner reveal">
    <p class="eyebrow eyebrow--muted">Our mission</p>
    <p class="mission-line">We're standardising the early-stage aerospace design process.</p>
  </div>
</section>

<style>
  .mission {
    padding-block: clamp(2.5rem, 5vw, 4rem);
