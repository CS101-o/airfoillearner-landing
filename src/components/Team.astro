---
// Responsibilities reuse what was already published (the old Footer.astro team
// list) where available. Ahmet Emre Arslan wasn't on that list, so his "does"
// is left blank below rather than guessed — fill in once the founders confirm it.
const team = [
  {
    name: "Kaan Oktem",
    role: "Chief Executive",
    does: "Technical lead; optimisation work",
    background: "Computer Science, University of Manchester",
  },
  {
    name: "Ege Artan",
    role: "Chief Product",
    does: "Meshing and dataset pipeline",
    background: "UTMIST research group, Toronto; author of three papers",
  },
  {
    name: "Davut Karatas",
    role: "Chief Technology",
    does: "Surrogate model and training",
    background: "Computer Science; UTMIST, Toronto",
  },
  {
    name: "Ahmet Emre Arslan",
    role: "Engineer",
    does: "",
    background: "Aerospace Engineer; TAI; Von Karman Institute for Fluid Dynamics",
  },
  {
    name: "Baramee Thanawarothon",
    role: "Chief Revenue",
    does: "BD and partnerships",
    background: "Former venture capital analyst, TK & Partners (deep tech); Electrical Engineering, University of Manchester",
  },
  {
    name: "Jackie Li",
    role: "Business",
    does: "Commercial pipeline and CRM",
    background: "Economics and Finance, University of Manchester",
  },
];
---

<section class="section team" id="team">
  <div class="shell">
    <div class="team-head reveal">
      <p class="eyebrow">The team</p>
      <h2>Built around the problem.</h2>
    </div>

    <div class="team-grid reveal">
      {
        team.map((t) => (
          <div class="team-card">
            <p class="tc-name">{t.name}</p>
            <p class="tc-role mono">{t.role}</p>
            {t.does && <p class="tc-does">{t.does}</p>}
            <p class="tc-bg">{t.background}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team {
    border-top: 1px solid var(--hair);
  }
  .team-head {
    margin-bottom: clamp(2.2rem, 4vw, 3rem);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hair);
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 1.6rem;
  }
  .team-card {
    background: var(--paper-2);
    padding: 1.6rem 1.5rem;
  }
  .tc-name {
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 0.3rem;
  }
  .tc-role {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }
  .tc-does {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0 0 0.6rem;
  }
  .tc-bg {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 880px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
